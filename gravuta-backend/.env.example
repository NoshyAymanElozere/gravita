# منفذ السيرفر (واجهة pharmaa تعمل على 3000 لذلك نستخدم 5000)
PORT=5000

# رابط الاتصال بقاعدة البيانات
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# مفتاح توقيع رموز JWT - استخدم قيمة عشوائية طويلة (مثلاً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# النطاقات المسموح لها بالاتصال (مفصولة بفاصلة) - اتركها فارغة للسماح للجميع أثناء التطوير
CORS_ORIGINS=http://localhost:3000

# قواعد الشحن والدفع (القيم الافتراضية مطابقة لواجهة pharmaa)
FREE_SHIPPING_THRESHOLD=200
SHIPPING_FEE=25
COD_FEE=15
ESTIMATED_DELIVERY_DAYS=3
RETURN_WINDOW_DAYS=14

# الدفع الإلكتروني معطل حتى يتم ربط بوابة دفع (Moyasar / Tap / Stripe)
ONLINE_PAYMENTS_ENABLED=false
